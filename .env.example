# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Open-source model access (choose one path; leave others blank)
# Hugging Face token for hosted inference, if used:
HF_TOKEN=
# OR a local/self-hosted OpenAI-compatible endpoint (e.g. vLLM, Ollama):
OPENSOURCE_BASE_URL=
OPENSOURCE_API_KEY=

# --- Added 2026-07-19 for src/run_experiments.py ---
# Exact model version string sent to each provider's API. WHICH tier of each
# of the three models to benchmark (RQ2) is a research-design decision - see
# docs/model_tier_recommendation.md for the sourced cost/capability analysis.
# DECIDED 2026-07-20 (Madhu): the "Mid" triple - Sonnet 5 (intro pricing) +
# GPT-5.6 Terra + a cheap open model, ~$21 for 2 runs with batch pricing,
# under CLAUDE.md's $30 cost guard. Claude and GPT strings below are
# confirmed exact API model IDs (independently verified, see the memo's
# commit for sources), pre-filled since the decision is made - copy this
# file to .env and they're ready to use as-is, no guessing needed:
CLAUDE_MODEL_NAME=claude-sonnet-5
GPT_MODEL_NAME=gpt-5.6-terra
# NOTE: OpenAI's bare "gpt-5.6" alias currently routes to Sol, not Terra -
# use the explicit "gpt-5.6-terra" string above, not the alias.
# OPENSOURCE_MODEL_NAME is still genuinely open: the memo recommends a
# hosted OpenAI-compatible endpoint (Together AI, Fireworks, Groq, or
# DeepInfra - see OPENSOURCE_BASE_URL above) over self-hosting, and
# DeepSeek V4 Pro as the model, but the exact model-ID string differs by
# provider (e.g. Together AI: "deepseek-ai/DeepSeek-V4-Pro"; DeepSeek's own
# direct API: "deepseek-v4-pro") - pick a provider first, then match its
# exact string, don't guess one.
OPENSOURCE_MODEL_NAME=

# Only relevant if the chosen open-source access path bills per token (e.g.
# HF hosted inference). Leave at 0 for a self-hosted endpoint with no
# per-token API cost (compute cost then needs to be tracked separately,
# outside this script).
OPENSOURCE_PRICE_INPUT_PER_MTOK=0
OPENSOURCE_PRICE_OUTPUT_PER_MTOK=0

# Which model acts as LLM-judge for src/judge.py (Method C, supplementary
# only). Must be one of: claude | gpt | opensource. Consider using a model
# NOT among the three under test, to avoid self-preference bias - a
# documented LLM-as-judge failure mode (see paper draft Section II.C).
JUDGE_MODEL_LABEL=claude
