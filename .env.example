# Copy to .env and fill in real values. .env is gitignored - never commit it.
#
# REDESIGNED 2026-07-23 (Madhu, budget-driven): the originally-decided paid
# triple (Anthropic Claude / OpenAI GPT / Together AI Llama) all hit real
# billing/quota errors on the first actual spend attempt - none of the 3
# accounts had funded billing. Rather than pay, every slot below now points
# at a genuinely free-tier provider (Google Gemini + Groq, both no-credit-
# card-required as of this writing). See CLAUDE.md's RQ2 correction note and
# docs/model_tier_recommendation.md's dated addendum for the full reasoning.
# Only 2 real accounts are needed now (Google AI Studio, Groq Cloud) - the
# "gpt" and "opensource" slots share one Groq key, just different models.

# Google AI Studio (https://aistudio.google.com/apikey) - free tier, no card.
# Used for the "claude" slot (MODEL_DISPATCH key name kept for continuity -
# it no longer calls Anthropic, see run_experiments.py's call_claude()).
GEMINI_API_KEY=

# Groq Cloud (https://console.groq.com/keys) - free tier, no card. Shared by
# BOTH the "gpt" slot (openai/gpt-oss-120b) and the "opensource" slot
# (qwen/qwen3.6-27b) below - same account, same key, different model names.
GROQ_API_KEY=

# --- Exact model version strings sent to each provider's API ---
# Gemini's free tier as of 2026-07-23 gives the highest daily request quota
# (1,500/day) to its Flash-tier models - re-verify this is still the current
# top-quota model ID on aistudio.google.com before a real run; free-tier
# terms and model names both churn.
CLAUDE_MODEL_NAME=gemini-2.5-flash

# gpt-oss-120b is OpenAI's own open-weight model family, served free by Groq
# - not OpenAI's paid API, but a real conceptual link to "GPT" for RQ2's
# framing. Re-confirm this exact ID on console.groq.com/docs/models before a
# real run - Groq has deprecated model IDs before (e.g. the original
# llama-3.3-70b-versatile this project used prior to this redesign).
GPT_MODEL_NAME=openai/gpt-oss-120b

# A second, distinct open-weight family from the GPT-oss slot above (keeps
# RQ2's 2 open-weight models genuinely different, not the same model twice).
# Re-confirm this exact ID on console.groq.com/docs/models before a real run,
# same caveat as above.
OPENSOURCE_MODEL_NAME=qwen/qwen3.6-27b

# Which model acts as LLM-judge for src/judge.py (Method C, supplementary
# only). Must be one of: claude | gpt | opensource. Consider using a model
# NOT among the three under test, to avoid self-preference bias - a
# documented LLM-as-judge failure mode (see paper draft Section II.C).
JUDGE_MODEL_LABEL=claude

# --- Legacy vars for the DORMANT --batch/--batch-check path only ---
# run_experiments.py's submit_claude_batch()/submit_gpt_batch() still call
# Anthropic's and OpenAI's own native batch APIs directly (not the Gemini/
# Groq redesign above) - see run_experiments.py's module docstring,
# "INAPPLICABLE as of the 2026-07-23 free-tier redesign". These are only
# needed if a future funded run reverts to paid Anthropic/OpenAI accounts
# and uses --batch; leave blank for the current free-tier setup, and do not
# pass --batch against GEMINI_API_KEY/GROQ_API_KEY - it will fail.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only relevant if using --batch with a real Together-AI-style opensource
# provider that bills per token (not applicable to the current Groq setup,
# which is free) - see estimate_cost()'s fallback in run_experiments.py.
OPENSOURCE_PRICE_INPUT_PER_MTOK=
OPENSOURCE_PRICE_OUTPUT_PER_MTOK=
