# Copy to .env and fill in real values. .env is gitignored - never commit it.
#
# REDESIGNED 2026-07-23 (Madhu, budget-driven): the originally-decided paid
# triple (Anthropic Claude / OpenAI GPT / Together AI Llama) all hit real
# billing/quota errors on the first actual spend attempt - none of the 3
# accounts had funded billing. Rather than pay, every slot moved to a
# genuinely free-tier provider (Google Gemini + Groq, both no-credit-
# card-required as of this writing).
#
# REDESIGNED AGAIN 2026-07-23 (later the same day): Groq's free tier turned
# out to have a hard 8,000 TPM per-request cap on both the "gpt" and
# "opensource" slots (confirmed against console.groq.com/docs/rate-limits) -
# this project's real prompts run ~30-34K tokens, ~4x over that cap, so every
# real call against Groq failed outright (not a pacing/retry problem). Those
# two slots moved to SambaNova Cloud instead - real-call verified with a
# genuine ~28,400-token corpus prompt before this file was updated (see
# PROJECT_SPEC.md's RQ2 note and docs/model_tier_recommendation.md's dated addenda
# for the full reasoning). Only 2 real accounts are needed now (Google AI
# Studio, SambaNova Cloud) - the "gpt" and "opensource" slots share one
# SambaNova key, just different models.

# Google AI Studio (https://aistudio.google.com/apikey) - free tier, no card.
# Used for the "claude" slot (MODEL_DISPATCH key name kept for continuity -
# it no longer calls Anthropic, see run_experiments.py's call_claude()).
GEMINI_API_KEY=

# GROQ_API_KEY retired entirely 2026-07-23 (second redesign, same day, not
# left dormant) - Groq's free tier has a structural 8K TPM per-request wall
# this project's real prompts exceed ~4x. No code path reads it anymore (see
# run_experiments.py/check_env.py - both now call SambaNova); removed from
# here too, not just left blank, since tests/test_env_example.py flags
# declared-but-unreferenced vars as stale. See git history before this
# commit if Groq is ever reconsidered.

# SambaNova Cloud (https://cloud.sambanova.ai) - free tier, no card required
# (their own docs: "Free Tier: Applied when there is no payment method linked
# with your account"). Shared by BOTH the "gpt" slot (gpt-oss-120b)
# and the "opensource" slot (Meta-Llama-3.3-70B-Instruct) below - same
# account, same key, different model names. NOT verified: whether the
# documented 200,000 tokens/day per-model budget is actually independent per
# model or shared account-wide - no rate-limit info is exposed in response
# headers, so this can only be confirmed by watching a real multi-day run.
SAMBANOVA_API_KEY=

# OPTIONAL, ADDED 2026-07-25: OpenRouter (https://openrouter.ai/keys) as a
# supplemental provider for the "gpt"/"opensource" slots ONLY - tried
# automatically inside call_gpt()/call_opensource() when SambaNova returns a
# transient (rate-limit/5xx) error, never in place of it. SambaNova's real
# daily caps (~6-7 calls/day/model) are the actual bottleneck on the grid
# timeline, not something retrying fixes - OpenRouter adds real, independent
# daily throughput for the exact same 2 open-weight models. Real-call
# verified (2026-07-25) against both `openai/gpt-oss-120b` and
# `meta-llama/llama-3.3-70b-instruct` with a genuine ~35,100-token corpus
# prompt - real, on-topic content from both. NOT free - OpenRouter's actual
# ":free"-suffixed tier does not include either of these exact models (only
# smaller/different ones, e.g. gpt-oss-20b:free) - but at $0.000000037-
# 0.0000004/token depending on model and prompt/completion, a ~35K-token
# call costs roughly $0.002-0.006, real but trivial money, not the paid-
# triple's dollar-per-run scale. Leave blank to keep the current SambaNova-
# only behavior unchanged (this is additive, not required).
OPENROUTER_API_KEY=

# --- Exact model version strings sent to each provider's API ---
# CORRECTED 2026-07-23 (smoke test finding): gemini-2.5-flash returned
# "404 - This model is no longer available to new users" on a real key -
# still listed in the API's model catalog, but access is restricted for new
# accounts. gemini-flash-latest verified working instead (real test call: 71
# total tokens, 2 output tokens). Also: Gemini's Flash models spend
# "thinking" tokens out of the max_tokens budget - a low max_tokens can
# silently return empty content even on success. This project's
# DEFAULT_MAX_OUTPUT_TOKENS=4096 should be enough headroom, but confirm
# against the first real generations rather than assume.
CLAUDE_MODEL_NAME=gemini-flash-latest

# gpt-oss-120b is OpenAI's own open-weight model family, served free by
# SambaNova Cloud (moved from Groq 2026-07-23 - same model, different host,
# see above) - not OpenAI's paid API, but a real conceptual link to "GPT" for
# RQ2's framing. Real-call verified against a ~28,400-token corpus prompt:
# succeeded, but needed max_tokens>=4096 to clear this model's own hidden
# reasoning-token spend first (same class of behavior as Gemini's "thinking
# tokens" above - a too-small max_tokens returns empty content, not an error).
# CORRECTED 2026-07-23 (real scoped-smoke-test finding, caught by the actual
# 9-call run, not the earlier ad-hoc verification script): SambaNova does
# NOT use Groq's "openai/" namespace prefix - `openai/gpt-oss-120b` gets a
# real 404 model_not_found from SambaNova's API ("does not exist or you do
# not have access to it"), even though that exact string was the correct
# Groq model ID. The bare `gpt-oss-120b` (no prefix) is what the earlier
# verification script actually used and what SambaNova expects.
GPT_MODEL_NAME=gpt-oss-120b

# A second, distinct open-weight family from the GPT-oss slot above (keeps
# RQ2's 2 open-weight models genuinely different, not the same model twice).
# Reverted 2026-07-23 from Qwen (qwen/qwen3.6-27b, Groq-only, not available
# on SambaNova) back to Meta-Llama-3.3-70B-Instruct - this project's ORIGINAL
# pre-redesign open-source pick, now back in service because it's already on
# SambaNova's free tier. Real-call verified against the same ~28,400-token
# corpus prompt: succeeded cleanly at even a small max_tokens, no
# reasoning-token overhead observed for this model.
OPENSOURCE_MODEL_NAME=Meta-Llama-3.3-70B-Instruct

# Which model acts as LLM-judge for src/judge.py (Method C, supplementary
# only). Must be one of: claude | gpt | opensource. Consider using a model
# NOT among the three under test, to avoid self-preference bias - a
# documented LLM-as-judge failure mode (see paper draft Section II.C).
JUDGE_MODEL_LABEL=claude

# --- Legacy vars for the DORMANT --batch/--batch-check path only ---
# run_experiments.py's submit_claude_batch()/submit_gpt_batch() still call
# Anthropic's and OpenAI's own native batch APIs directly (not the Gemini/
# Groq redesign above) - see run_experiments.py's module docstring,
# "INAPPLICABLE as of the 2026-07-23 free-tier redesign". These are only
# needed if a future funded run reverts to paid Anthropic/OpenAI accounts
# and uses --batch; leave blank for the current free-tier setup, and do not
# pass --batch against GEMINI_API_KEY/GROQ_API_KEY - it will fail.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only relevant if using --batch with a real Together-AI-style opensource
# provider that bills per token (not applicable to the current Groq setup,
# which is free) - see estimate_cost()'s fallback in run_experiments.py.
OPENSOURCE_PRICE_INPUT_PER_MTOK=
OPENSOURCE_PRICE_OUTPUT_PER_MTOK=
