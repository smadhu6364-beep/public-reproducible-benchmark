# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Open-source model access (choose one path; leave others blank)
# Hugging Face token for hosted inference, if used:
HF_TOKEN=
# OR a local/self-hosted OpenAI-compatible endpoint (e.g. vLLM, Ollama):
# DECIDED 2026-07-21 (Madhu): Together AI, hosting Llama 3.3 70B Turbo - see
# docs/opensource_slot_options.md for the sourced comparison across providers.
OPENSOURCE_BASE_URL=https://api.together.xyz/v1
OPENSOURCE_API_KEY=

# --- Added 2026-07-19 for src/run_experiments.py ---
# Exact model version string sent to each provider's API. WHICH tier of each
# of the three models to benchmark (RQ2) is a research-design decision - see
# docs/model_tier_recommendation.md for the sourced cost/capability analysis.
# DECIDED 2026-07-20 (Madhu): the "Mid" triple - Sonnet 5 (intro pricing) +
# GPT-5.6 Terra + a cheap open model, ~$21 for 2 runs with batch pricing,
# under CLAUDE.md's $30 cost guard. Claude and GPT strings below are
# confirmed exact API model IDs (independently verified, see the memo's
# commit for sources), pre-filled since the decision is made - copy this
# file to .env and they're ready to use as-is, no guessing needed:
CLAUDE_MODEL_NAME=claude-sonnet-5
GPT_MODEL_NAME=gpt-5.6-terra
# NOTE: OpenAI's bare "gpt-5.6" alias currently routes to Sol, not Terra -
# use the explicit "gpt-5.6-terra" string above, not the alias.
# NOTE 2026-07-21: GPT-5-family reasoning models (plausibly incl. Terra) are
# documented to reject `temperature` outright in reasoning mode. run_experiments.py's
# call_gpt() now detects this and retries without temperature, logging it loudly
# and recording temperature_applied=false rather than hiding it - but this has
# NOT been exercised against a real API call (no key has existed yet). Check
# results/run_config.jsonl's temperature_applied field after the first few real
# GPT runs - if it's ever false, that's a real methodology caveat, not a bug to
# ignore (see run_experiments.py's module docstring + paper draft Section V.A).
# DECIDED 2026-07-21 (Madhu): Llama 3.3 70B Turbo via Together AI - the
# most recognizable/citable open-weight baseline, a stable model ID (Together
# did not deprecate it, unlike Groq's equivalent), and zero code changes
# needed (call_opensource()'s existing OpenAI-compatible base-URL path).
# Model IDs on hosted providers do churn - re-confirm this exact string on
# Together's live model list (or `GET /models`) before the real run; see
# docs/opensource_slot_options.md for the full comparison and other rows if
# this needs to change (e.g. DeepSeek-V3 for more capability, DeepInfra for
# a cheaper host of the same model).
OPENSOURCE_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Together AI bills per token even via its OpenAI-compatible endpoint, so
# this must be set (unlike a true self-hosted endpoint, where 0 is correct
# and compute cost is tracked separately). $1.04/MTok flat (input=output) -
# CORRECTED 2026-07-21: docs/opensource_slot_options.md originally said
# ~$0.88, sourced 2026-07-20; independently re-verified directly against
# together.ai/pricing and together.ai/models/llama-3-3-70b on 2026-07-21 and
# both show $1.04/MTok, ~18% higher. Re-verify again before a real run if
# more than a few weeks have passed - these tables change.
OPENSOURCE_PRICE_INPUT_PER_MTOK=1.04
OPENSOURCE_PRICE_OUTPUT_PER_MTOK=1.04

# Which model acts as LLM-judge for src/judge.py (Method C, supplementary
# only). Must be one of: claude | gpt | opensource. Consider using a model
# NOT among the three under test, to avoid self-preference bias - a
# documented LLM-as-judge failure mode (see paper draft Section II.C).
JUDGE_MODEL_LABEL=claude
