# Data: never commit raw source PDFs
data/raw/

# Data: excised risk-source pages (SORT table + Key Risks narrative), kept
# only for human audit of the excision boundary - same leakage sensitivity
# as data/raw, never commit, never load into a prompt.
data/risk_source_audit/

# Scratch/prototype work - includes early excise/match/metrics prototypes
# (since superseded by the real src/ implementations) and scratch/out/risk_source/,
# which holds excised risk-source content with the same leakage sensitivity as
# data/risk_source_audit/ above. Never commit.
scratch/

# Secrets
.env

# Method B rater blinding key - maps opaque packet codes (REG-###) back to
# (model, prompt) and de-anonymizes the blind evaluation. Same "never let this
# reach a rater" sensitivity as ground truth; must not be committed. Written by
# src/build_rater_packets.py. The shareable rater assignment sheets and packets
# alongside it (codes only, no model/prompt/ground-truth) are NOT ignored.
results/rater_packets/blinding_map.csv

